# ArogyaX — environment variables (Phase 1)
# This is a prototype. Never commit a real .env / .env.local file with secrets.

# Reserved for signing the session cookie once auth moves off the
# base64-only prototype format. Not read by any Phase 1 code.
# SESSION_SECRET=

# PostgreSQL database connection string (required for Vercel production deployment)
# e.g., postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/arogyax?schema=public"

# Symptom checker provider: "llama" for local GPU service (default) or "mock"
AI_SYMPTOM_CHECKER_PROVIDER=llama
LOCAL_AI_SERVICE_URL=http://127.0.0.1:8000